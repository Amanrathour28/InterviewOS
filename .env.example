# ==============================================================================
# InterviewOS - Environment Configuration
# ==============================================================================

# Application
APP_NAME=InterviewOS
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-super-secret-key-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Client / Web App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Database (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=interviewos
POSTGRES_PASSWORD=interviewos_secret
POSTGRES_DB=interviewos_db
DATABASE_URL=postgresql+asyncpg://interviewos:interviewos_secret@localhost:5432/interviewos_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=interviewos-assets
MINIO_USE_SSL=False

# Mail (Mailpit for dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL=notifications@interviewos.local
EMAILS_FROM_NAME=InterviewOS

# AI Gateway & Multi-Agent Intelligence Foundation (Phase 12)
AI_PROVIDER=groq
GROQ_API_KEY=gsk_placeholder_add_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
AI_FALLBACK_PROVIDER=ollama
AI_SERVICE_URL=http://localhost:8001/api/v1
AI_SERVICE_PORT=8001
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=3
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2048
AI_LOG_REQUESTS=True
AI_STRUCTURED_OUTPUT_MODE=json_schema

# Code Runner Sandbox
CODE_RUNNER_DOCKER_NETWORK=interviewos_sandbox_net
CODE_RUNNER_TIMEOUT_SECONDS=10
CODE_RUNNER_MEMORY_LIMIT_MB=256
CODE_RUNNER_CPU_LIMIT=1.0

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
