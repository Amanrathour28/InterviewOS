# ==============================================================================
# InterviewOS — Environment Configuration Matrix (Phase 16.2 Production)
# ==============================================================================
# Split into:
# 1. Frontend / Public (NEXT_PUBLIC_*) -> Safe for browser exposure
# 2. Backend / Server-only Secrets -> NEVER expose via NEXT_PUBLIC_*
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND PUBLIC ENVIRONMENT VARIABLES (Vercel & Next.js)
# ------------------------------------------------------------------------------
# The canonical URL where the web app is hosted (e.g. https://interviewos.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The HTTP URL of the FastAPI Backend API (e.g. https://api.interviewos.com/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# The WebSocket URL of the Persistent Realtime Gateway (e.g. https://realtime.interviewos.com)
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000

# WebRTC STUN / TURN Configuration
NEXT_PUBLIC_STUN_URL=stun:stun.l.google.com:19302
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# ------------------------------------------------------------------------------
# 2. CORE BACKEND & SECURITY (Server-only)
# ------------------------------------------------------------------------------
APP_NAME=InterviewOS
APP_ENV=production
DEBUG=False
API_V1_STR=/api/v1

# Generate with: openssl rand -hex 32 (min 32 characters)
SECRET_KEY=generate-a-secure-32-char-random-secret-key-for-jwt
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS Origins (comma-separated or JSON list, e.g. https://interviewos.vercel.app)
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://interviewos.vercel.app"]

# ------------------------------------------------------------------------------
# 3. DATABASE (Neon Serverless PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
# Neon connection string with pooler (e.g. postgresql+asyncpg://user:pass@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?ssl=require)
DATABASE_URL=postgresql+asyncpg://interviewos:interviewos_secret@localhost:5432/interviewos_db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=interviewos
POSTGRES_PASSWORD=interviewos_secret
POSTGRES_DB=interviewos_db

# ------------------------------------------------------------------------------
# 4. REDIS CACHE & PUB/SUB (Upstash Redis / Managed Redis)
# ------------------------------------------------------------------------------
# Connection string (e.g. rediss://default:password@xyz.upstash.io:6379)
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 5. OBJECT STORAGE (Cloudflare R2 / AWS S3 / MinIO)
# ------------------------------------------------------------------------------
# S3 compatible bucket for resumes and interview artifacts
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=interviewos-assets
MINIO_USE_SSL=False
# S3_REGION=auto # (e.g. us-east-1 or auto for R2)

# ------------------------------------------------------------------------------
# 6. AI INTELLIGENCE & EVALUATIONS (Groq Cloud + Ollama)
# ------------------------------------------------------------------------------
AI_PROVIDER=groq
# Get free Groq API key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Fallback provider configuration
AI_FALLBACK_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# AI Execution parameters
AI_SERVICE_URL=http://localhost:8001/api/v1
AI_SERVICE_PORT=8001
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=3
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2048
AI_LOG_REQUESTS=True
AI_STRUCTURED_OUTPUT_MODE=json_schema

# ------------------------------------------------------------------------------
# 7. EMAIL SERVICE (Resend / SendGrid / Amazon SES / Mailpit)
# ------------------------------------------------------------------------------
# In production, use standard TLS SMTP (e.g. smtp.resend.com, port 587)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL=notifications@interviewos.com
EMAILS_FROM_NAME=InterviewOS

# ------------------------------------------------------------------------------
# 8. SECURE CODE EXECUTION ENGINE (Isolated Worker)
# ------------------------------------------------------------------------------
CODE_RUNNER_DOCKER_NETWORK=interviewos_sandbox_net
CODE_RUNNER_TIMEOUT_SECONDS=5
CODE_RUNNER_MEMORY_LIMIT_MB=256
CODE_RUNNER_CPU_LIMIT=1.0
